<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NoMistake Phase 4A - Classic Outlook COM 연결 검증 콘솔(PC Companion 원형)

    빌드 방법(현재 개발 PC - .NET SDK 미설치): build.ps1 (Windows 내장 csc.exe, .NET Framework 4.x)
    빌드 방법(.NET SDK 설치 후)          : dotnet build
    두 방식 모두 동일한 Program.cs를 사용한다. COM 접근은 dynamic late-binding
    (ProgID 'Outlook.Application') 방식이라 interop 어셈블리/COMReference가 필요 없다.
    실행에는 Classic Outlook이 설치/로그인되어 있어야 한다(새 Outlook(monarch)은 COM 미지원).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>OutlookCompanion</RootNamespace>
    <AssemblyName>OutlookCompanion</AssemblyName>
  </PropertyGroup>

</Project>