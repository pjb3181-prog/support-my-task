<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NoMistake Phase 4A~4C - Classic Outlook COM 기반 PC Companion(Firestore 전달 계층 포함)

    빌드: .NET SDK 8(net8.0) + NuGet restore(Google.Cloud.Firestore). build.ps1 사용.
          Phase 4C부터 Firestore SDK(NuGet)가 필요해 csc.exe 단독 빌드는 지원 종료했다.
    구조: ComHost/EventModels/SnapshotDiff/SnapshotStore/MeriAccess/MeriReader/Gates/SelfTest/Program
          (4B) + FirestoreModels/FirestoreSync/FirestoreTest(4C, 서비스 계정 JSON 인증 + diff 기반
          최소 write). SDK 스타일 glob으로 전부 자동 포함된다.
    COM 접근은 dynamic late-binding(ProgID 'Outlook.Application')이라 interop 어셈블리/COMReference가
    필요 없고, ROT attach는 oleaut32!GetActiveObject P/Invoke로 직접 구현해 net8에서도 빌드된다.
    실행에는 Classic Outlook이 설치/로그인되어 있어야 한다(새 Outlook(monarch)은 COM 미지원).
    Firebase credential은 %LOCALAPPDATA%\NoMistakeCompanion\firebase-service-account.json(Git 밖,
    사용자 전용 ACL). 절대 repository에 커밋하지 않는다(.gitignore 패턴 방어 포함).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>OutlookCompanion</RootNamespace>
    <AssemblyName>OutlookCompanion</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.Firestore" Version="4.4.0" />
  </ItemGroup>

</Project>