<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NoMistake Phase 4A/4B - Classic Outlook COM 기반 PC Companion 검증 콘솔

    빌드 방법(현재 개발 PC - .NET SDK 미설치): build.ps1 (Windows 내장 csc.exe, .NET Framework 4.x)
    빌드 방법(.NET SDK 설치 후)          : dotnet build
    Phase 4B는 기능별 다중 파일 구조(ComHost/EventModels/SnapshotDiff/SnapshotStore/
    MeriAccess/MeriReader/Gates/SelfTest/Program)이며 SDK 스타일 glob으로 전부 자동 포함된다.
    COM 접근은 dynamic late-binding(ProgID 'Outlook.Application')이라 interop 어셈블리/COMReference가
    필요 없고, ROT attach는 oleaut32!GetActiveObject P/Invoke로 직접 구현해 net8에서도 빌드된다.
    실행에는 Classic Outlook이 설치/로그인되어 있어야 한다(새 Outlook(monarch)은 COM 미지원).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>OutlookCompanion</RootNamespace>
    <AssemblyName>OutlookCompanion</AssemblyName>
  </PropertyGroup>

</Project>