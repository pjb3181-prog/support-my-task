<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NoMistake PC Companion - Classic Outlook COM + Firestore + lightweight Windows tray host.

    빌드: .NET SDK 8(net8.0-windows) + NuGet restore(Google.Cloud.Firestore). build.ps1 사용.
    COM 접근은 dynamic late-binding(ProgID 'Outlook.Application')이라 interop 어셈블리/COMReference가
    필요 없다. Firebase credential은 %LOCALAPPDATA%\NoMistakeCompanion 아래에만 두며 Git에
    커밋하지 않는다.

    TrayProgram이 실제 entry point다.
    - 인자 없이 실행 또는 tray 인자: console 없는 NotifyIcon tray app
    - 기존 test/upload/once 등 CLI 인자: 기존 Program.Main으로 위임하여 호환 유지
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>OutlookCompanion.TrayProgram</StartupObject>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>OutlookCompanion</RootNamespace>
    <AssemblyName>OutlookCompanion</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.Firestore" Version="4.4.0" />
  </ItemGroup>

</Project>